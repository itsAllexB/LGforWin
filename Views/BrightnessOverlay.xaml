<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LGforWin.Views.BrightnessOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A normal window: its acrylic SystemBackdrop fills the client area and DWM clips it to the
         native Win11 rounded corners (see code-behind). Root is transparent so the acrylic shows
         through, and it's click-through. The whole window slides + fades as a unit. -->
    <Grid x:Name="Root" Background="Transparent" IsHitTestVisible="False" IsTabStop="False">

        <!-- Unpaired prompt: shown instead of the brightness bar when a hotkey targets the cursor's
             TV but that screen isn't paired to one. -->
        <Grid x:Name="MessageContent" Visibility="Collapsed" Margin="16,0"
              ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
            <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="20" VerticalAlignment="Center"
                      Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="MsgTitle" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="MsgSubtitle" FontSize="11" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <StackPanel x:Name="BrightnessContent" VerticalAlignment="Center" Margin="16,0" Spacing="3">

            <!-- TV name (only shown when enabled) -->
            <TextBlock x:Name="NameText"
                       Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="12" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" MaxLines="1"
                       HorizontalAlignment="Stretch" TextAlignment="Center" />

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">

                <FontIcon Grid.Column="0" x:Name="GlyphIcon" Glyph="&#xE706;" FontSize="16"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />

                <!-- Layout-based bar (no ProgressBar animation, so it can't glitch on rapid changes) -->
                <Border Grid.Column="1" Height="4" CornerRadius="2" VerticalAlignment="Center"
                        Background="{ThemeResource ControlStrongFillColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="FillColumn" Width="0*" />
                            <ColumnDefinition x:Name="RestColumn" Width="100*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="2"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                    </Grid>
                </Border>

                <TextBlock Grid.Column="2" x:Name="ValueText"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           FontSize="15" FontWeight="Medium"
                           MinWidth="22" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
