<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LGforWin.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LGforWin.ViewModels"
    xmlns:local="using:LGforWin.Views"
    Loaded="OnPageLoaded">

    <Grid RowDefinitions="Auto,Auto,*" Padding="24,12,24,24" RowSpacing="16">

        <!-- SSDP auto-discovery: scans the LAN for webOS TVs and adds them by one click. Lives in
             the visual tree (it renders nothing until shown) — a ContentDialog in Page.Resources
             dims the page but never draws its content. -->
        <ContentDialog x:Name="DiscoverDialog"
                       Title="Find TVs on your network"
                       PrimaryButtonText="Scan again"
                       CloseButtonText="Done"
                       DefaultButton="Close"
                       PrimaryButtonClick="OnScanAgainClick">
            <StackPanel Spacing="12" MinWidth="400">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ProgressRing x:Name="ScanRing" Width="18" Height="18" IsActive="False" />
                    <TextBlock x:Name="ScanStatus" Text="Searching for LG TVs…"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <ItemsControl x:Name="DiscoveredList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:DiscoveredTvItem">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,6">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Details}" Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" MinWidth="88" VerticalAlignment="Center"
                                        Content="{x:Bind ButtonText, Mode=OneWay}"
                                        IsEnabled="{x:Bind CanAdd, Mode=OneWay}"
                                        Click="OnAddDiscoveredClick" Tag="{x:Bind}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ContentDialog>


        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="TVs" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Drag a slider to set OLED Light. Global hotkeys adjust the TV on the screen your cursor is on — pair each TV to its monitor below. Drag cards to reorder."
                       Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Add TV -->
        <Grid Grid.Row="1" ColumnSpacing="8" ColumnDefinitions="*,Auto,Auto,Auto" VerticalAlignment="Center">
            <TextBox Grid.Column="0" PlaceholderText="Name (e.g. Living Room C3)"
                     Text="{x:Bind VM.NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Grid.Column="1" Width="160" PlaceholderText="IP address"
                     Text="{x:Bind VM.NewHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="2" Content="Add TV" Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind VM.AddTvCommand}" />
            <Button Grid.Column="3" Click="OnFindTvsClick"
                    ToolTipService.ToolTip="Scan the local network for LG TVs — no IP needed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE721;" FontSize="14" />
                    <TextBlock Text="Find TVs" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- TV list -->
        <ListView Grid.Row="2" ItemsSource="{x:Bind VM.Tvs}"
                  SelectedItem="{x:Bind VM.ActiveTv, Mode=TwoWay}"
                  SelectionMode="Single"
                  CanReorderItems="True" AllowDrop="True" ReorderMode="Enabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,12" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TvViewModel">
                    <Border Padding="16" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                         Fill="{x:Bind StatusBrush, Mode=OneWay}" />
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                                Visibility="{x:Bind ActiveVisibility, Mode=OneWay}">
                                            <TextBlock Text="Active" FontSize="11" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="{x:Bind Host}" />
                                        <Run Text=" · " />
                                        <Run Text="{x:Bind StatusText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <ProgressRing Grid.Column="2" Width="16" Height="16" VerticalAlignment="Center"
                                              IsActive="{x:Bind IsBusy, Mode=OneWay}" />
                                <Button Grid.Column="3" Click="OnPowerClick" Tag="{x:Bind}"
                                        AutomationProperties.Name="Power"
                                        ToolTipService.ToolTip="Turn the TV off — or wake it when it's off">
                                    <FontIcon Glyph="&#xE7E8;" FontSize="14" />
                                </Button>
                                <Button Grid.Column="4" Content="Remove" Click="OnRemoveClick" Tag="{x:Bind}" />
                            </Grid>
                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                <FontIcon Grid.Column="0" Glyph="&#xE706;" FontSize="16" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                        Value="{x:Bind Backlight, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" MinWidth="44" TextAlignment="Right" VerticalAlignment="Center"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}">
                                    <Run Text="{x:Bind Backlight, Mode=OneWay}" /><Run Text="%" />
                                </TextBlock>
                            </Grid>

                            <!-- OSD screen pairing: which display this TV drives, so the overlay can appear
                                 on it when "Screen of the TV I'm adjusting" is chosen. Only shown when there's
                                 more than one display to choose between. -->
                            <Border Grid.Row="2" Visibility="{x:Bind ScreenPickerVisibility, Mode=OneWay}"
                                    Padding="12,10" CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                    <FontIcon Grid.Column="0" Glyph="&#xE7F4;" FontSize="16" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Pair with a monitor" />
                                        <TextBlock Text="Match this TV to the Windows display it shows up as, so the cursor hotkey and the on-screen overlay know which screen it is."
                                                   Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" MinWidth="170" VerticalAlignment="Center"
                                              ItemsSource="{x:Bind AvailableScreens}"
                                              DisplayMemberPath="Name"
                                              SelectedItem="{x:Bind SelectedScreen, Mode=TwoWay}"
                                              PlaceholderText="Pick this TV's monitor" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
