<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LGforWin.Views.SchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LGforWin.ViewModels">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="24,12,24,24" RowSpacing="16">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Schedule" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Automatically set brightness at times of day (applies to all TVs). Up to 5 schedules."
                       Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Catch-up on startup -->
        <Border Grid.Row="1" Padding="16" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Apply the active schedule on startup" />
                    <TextBlock Text="When the app opens, set each TV to whichever schedule is currently in effect — catching up rules that ran while the PC was off."
                               Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" MinWidth="0"
                              IsOn="{x:Bind VM.ApplyScheduleOnStartup, Mode=TwoWay}" />
            </Grid>
        </Border>

        <!-- Add -->
        <Button Grid.Row="2" Content="Add schedule" HorizontalAlignment="Left"
                Style="{ThemeResource AccentButtonStyle}"
                Command="{x:Bind VM.AddScheduleCommand}" />

        <!-- List -->
        <ScrollViewer Grid.Row="3">
            <StackPanel Spacing="12">
                <ItemsControl ItemsSource="{x:Bind VM.Schedules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScheduleViewModel">
                            <Border Padding="16" CornerRadius="8" Margin="0,0,0,4"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                                    <TimePicker Grid.Column="0" VerticalAlignment="Center"
                                                ClockIdentifier="{x:Bind ClockId}"
                                                Time="{x:Bind Time, Mode=TwoWay}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="Set brightness to" />
                                            <Run Text="{x:Bind Brightness, Mode=OneWay}" /><Run Text="%" />
                                        </TextBlock>
                                        <Slider Minimum="0" Maximum="100" Value="{x:Bind Brightness, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <ToggleSwitch IsOn="{x:Bind Enabled, Mode=TwoWay}" MinWidth="0" />
                                        <Button Click="OnRemoveClick" Tag="{x:Bind}"
                                                AutomationProperties.Name="Remove schedule"
                                                ToolTipService.ToolTip="Remove">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No schedules yet. Add one above."
                           Visibility="{x:Bind EmptyVisibility, Mode=OneTime}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{ThemeResource CaptionTextBlockStyle}" Margin="2,8,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
